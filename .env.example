# Select openai or openrouter for live play. Recommended when switching providers.
INTRUSIVE_THOUGHTS_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional attribution headers sent only to OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Intrusive Thoughts

# Set to fake for an offline controller/UI smoke test. Omit for the live gateway.
INTRUSIVE_THOUGHTS_GATEWAY=
# Optional override. The default is Electron userData/prototype-data.
INTRUSIVE_THOUGHTS_DATA_ROOT=
